// Original ScriptUI dictionary editor; dictionaries remain inert data.
function LBOpenDictionaryManager(root,notify,stopBackend){
 var own=Object.prototype.hasOwnProperty,folder=new Folder(root.fsName+'/dictionaries'),runtime=new Folder(root.fsName+'/runtime');if(!runtime.exists)runtime.create();
 function read(file){file.encoding='UTF-8';if(!file.open('r'))throw Error('无法读取 '+file.fsName);try{return LBJSON.parse(file.read());}finally{file.close();}}
 function file(kind,base){return new File(folder.fsName+'/Kosuzu.'+(base?'base.':'')+kind+'.json');}
 function validate(map){if(!map||typeof map!=='object'||map instanceof Array)throw Error('词典必须是JSON对象');for(var k in map)if(own.call(map,k)){if(!k||typeof map[k]!=='string')throw Error('词条必须为文本：'+k);if(k==='__proto__'||k==='constructor'||k==='prototype')throw Error('不支持此保留键：'+k);}return map;}
 function escapeText(s){var text=String(s),result='',c;for(var i=0;i<text.length;i++){c=text.charAt(i);if(c==='\\')result+='\\\\';else if(c==='=')result+='\\=';else if(c==='\r')result+='\\r';else if(c==='\n')result+='\\n';else if(c==='\t')result+='\\t';else result+=c;}return result;}
 function unescapeText(s){return s.replace(/\\(.)/g,function(all,c){if(c==='n')return '\n';if(c==='r')return '\r';if(c==='t')return '\t';if(c==='='||c==='\\')return c;throw Error('无效转义 '+all);});}
 function format(map){var keys=[],k;for(k in map)if(own.call(map,k))keys.push(k);keys.sort();var lines=[];for(var i=0;i<keys.length;i++)lines.push(escapeText(keys[i])+'='+escapeText(map[keys[i]]));return lines.join('\n');}
 function parse(text){var map={},lines=String(text).split(/\r\n|\n|\r/),missing=0;
  for(var i=0;i<lines.length;i++){var line=lines[i];if(!line.replace(/\s/g,''))continue;var pos=-1,slash=false;for(var j=0;j<line.length;j++){var c=line.charAt(j);if(slash){slash=false;continue;}if(c==='\\'){slash=true;continue;}if(c==='='){pos=j;break;}}
   if(pos<0)throw Error('第'+(i+1)+'行缺少等号');var key=unescapeText(line.substring(0,pos)),value=unescapeText(line.substring(pos+1));if(!key.length)throw Error('第'+(i+1)+'行原文为空');if(own.call(map,key)&&map[key]!==value)throw Error('重复原文存在不同译文：'+key);map[key]=value;if(!value.length)missing++;
  }validate(map);return {map:map,missing:missing};
 }
 function merge(a,b){for(var k in b)if(own.call(b,k))a[k]=b[k];return a;}
 function translated(key,value){return typeof value==='string'&&value!==key&&value.replace(/\s/g,'').length>0;}
 function clean(map){var result={};for(var k in map)if(own.call(map,k)&&translated(k,map[k]))result[k]=map[k];return result;}
 function unknown(map,known){var result={};for(var k in map)if(own.call(map,k)&&!(own.call(known,k)&&translated(k,known[k])))result[k]=map[k];return result;}
 function known(kind){return merge(clean(validate(read(file(kind,true)))),clean(validate(read(file(kind)))));}
 function copied(text){var map=parse(text).map,keys=[],k;for(k in map)if(own.call(map,k)&&!map[k].replace(/\s/g,'').length){if(/[\r\n]/.test(k))throw Error('原文含换行，请改用JSON导出');keys.push(k);}keys.sort();if(!keys.length)throw Error('没有尚未填写的原文');return {keys:keys,draft:text,text:keys.join('\r\n')};}
 function pastedDraft(text,pasted,snapshot){if(!String(pasted).replace(/\s/g,'').length)throw Error('剪贴板没有文本');var old=parse(text).map,incoming=null;try{incoming=parse(pasted).map;}catch(ignore){}
  if(incoming){for(var key in incoming)if(own.call(incoming,key)&&!own.call(old,key))throw Error('粘贴含不属于当前草稿的原文：'+key);}
  else{if(!snapshot||snapshot.draft!==text)throw Error('请先用此区域的复制按钮复制原文；草稿改变后需重新复制');var lines=pasted.split(/\r\n|\n|\r/);if(lines.length===snapshot.keys.length+1&&lines[lines.length-1]==='')lines.pop();if(lines.length!==snapshot.keys.length)throw Error('译文行数 '+lines.length+' 与复制原文 '+snapshot.keys.length+' 不符，未改动草稿');incoming={};for(var i=0;i<lines.length;i++)incoming[snapshot.keys[i]]=lines[i];}
  return format(merge(old,incoming));
 }
 function count(map){var n=0;for(var k in map)if(own.call(map,k))n++;return n;}
 if(typeof LB_EDITOR_TEST!=='undefined'&&LB_EDITOR_TEST)return {parse:parse,format:format,clean:clean,unknown:unknown,copied:copied,pastedDraft:pastedDraft};
 var dialog=new Window('palette','本居小铃 · 批量待译词典 0.8',undefined,{resizeable:true});dialog.orientation='column';dialog.alignChildren=['fill','top'];dialog.preferredSize=[740,720];
 var top=dialog.add('group'),imp=top.add('button',undefined,'导入 JSON'),exp=top.add('button',undefined,'导出 JSON'),edit=top.add('button',undefined,'查看已保存数量'),clearLocal=top.add('button',undefined,'清空本地自定义');
 var nPanel=dialog.add('panel',undefined,'插件名称（英文=译文）'),nBox=nPanel.add('edittext',undefined,'',{multiline:true,scrolling:true});nPanel.alignChildren=['fill','fill'];nPanel.alignment=['fill','fill'];nBox.preferredSize=[690,190];
 var pPanel=dialog.add('panel',undefined,'参数与分组（英文=译文）'),pBox=pPanel.add('edittext',undefined,'',{multiline:true,scrolling:true});pPanel.alignChildren=['fill','fill'];pPanel.alignment=['fill','fill'];pBox.preferredSize=[690,230];
 var capture=dialog.add('button',undefined,'读取所选图层的全部效果名称与参数 → 填写译文');
 var tools=dialog.add('group'),formatButton=tools.add('button',undefined,'整理格式'),dedupe=tools.add('button',undefined,'去除基础词库已有的同译文项'),clearDraft=tools.add('button',undefined,'清空草稿');
 var status=dialog.add('statictext',undefined,'草稿按增量合并保存；空译文保留在草稿，保存时跳过。',{multiline:true});status.preferredSize.height=42;
 var save=dialog.add('button',undefined,'备份并保存到本地自定义词典'),bottom=dialog.add('group'),reload=bottom.add('button',undefined,'重新加载后端词典'),stop=bottom.add('button',undefined,'关闭后端并恢复原文'),close=bottom.add('button',undefined,'关闭',{name:'cancel'});close.onClick=function(){dialog.close();};
 var copySnapshots={};
 nPanel.orientation=pPanel.orientation='column';
 function clipboardAction(box,kind,copy){
  var helper=new File(root.fsName+'/backend/KosuzuClipboard.exe');if(!helper.exists)throw Error('原生剪贴板助手缺失，请使用完整包');
  var stamp=(new Date()).getTime(),textFile=new File(runtime.fsName+'/clipboard-'+stamp+'.txt'),ack=new File(runtime.fsName+'/clipboard-'+stamp+'.status');
 if(copy){var snapshot=copied(box.text);textFile.encoding='UTF-8';if(!textFile.open('w'))throw Error('无法写入临时文本');try{textFile.write(snapshot.text);}finally{textFile.close();}}
  system.callSystem('"'+helper.fsName+'" '+(copy?'copy':'paste')+' "'+textFile.fsName+'" "'+ack.fsName+'"');
  if(!ack.exists||!ack.open('r'))throw Error('剪贴板助手未完成');var result=ack.read();ack.close();ack.remove();if(result!=='OK')throw Error('剪贴板访问失败，稍后重试');
  if(copy){copySnapshots[kind]=snapshot;textFile.remove();report('已复制 '+snapshot.keys.length+' 条待译原文。可批量翻译后直接粘贴；译文须保持相同行数。');return;}
  textFile.encoding='UTF-8';if(!textFile.open('r'))throw Error('无法读取剪贴板文本');var pasted=textFile.read().replace(/^\uFEFF/,'');textFile.close();textFile.remove();
  var nextText=pastedDraft(box.text,pasted,copySnapshots[kind]);
  var backup=new File(runtime.fsName+'/before-paste-'+kind+'-'+stamp+'.txt');backup.encoding='UTF-8';if(!backup.open('w'))throw Error('粘贴前草稿备份失败');try{backup.write(box.text);}finally{backup.close();}
  box.text=nextText;report('已批量粘贴；仍需点击保存。粘贴前草稿已备份。');
 }
 function clipboardButtons(panel,box,kind){var actions=panel.add('group'),copy=actions.add('button',undefined,'一键复制待译原文'),paste=actions.add('button',undefined,'一键粘贴翻译结果');actions.alignment=['left','bottom'];copy.onClick=safe(function(){clipboardAction(box,kind,true);});paste.onClick=safe(function(){clipboardAction(box,kind,false);});}
 clipboardButtons(nPanel,nBox,'names');clipboardButtons(pPanel,pBox,'parameters');
 function report(s){status.text=s;}function safe(fn){return function(){try{fn();}catch(e){report('未完成：'+e.toString());}};}
 function draft(){return {names:parse(nBox.text),parameters:parse(pBox.text)};}
 function chooseKind(){var pick=new Window('dialog','词典类型'),list=pick.add('dropdownlist',undefined,['插件名称','插件参数']);list.selection=0;pick.add('button',undefined,'确定',{name:'ok'});pick.add('button',undefined,'取消',{name:'cancel'});return pick.show()===1?(list.selection.index===0?'names':'parameters'):null;}
 function replaceDraft(n,p){if((nBox.text||pBox.text)&&!confirm('替换当前两个编辑区的草稿？已保存的本地词典不受影响。'))return;nBox.text=format(n);pBox.text=format(p);report('草稿：名称 '+count(n)+' 条，参数 '+count(p)+' 条。');}
 function write(target,map){target.encoding='UTF-8';if(!target.open('w'))throw Error('无法写入 '+target.fsName);try{if(!target.write(LBJSON.stringify(map)))throw Error(target.error);}finally{target.close();}}
 function persist(n,p){var stamp=(new Date()).getTime(),backup=new Folder(runtime.fsName+'/dictionary-backups/'+stamp);if(!backup.parent.exists)backup.parent.create();if(!backup.create())throw Error('无法建立备份目录');var nf=file('names'),pf=file('parameters');if(!nf.copy(backup.fsName+'/'+nf.name)||!pf.copy(backup.fsName+'/'+pf.name))throw Error('备份失败，停止写入');
  try{write(nf,n);write(pf,p);}catch(e){var restored1=new File(backup.fsName+'/'+nf.name).copy(nf.fsName),restored2=new File(backup.fsName+'/'+pf.name).copy(pf.fsName);throw Error('写入失败，回退结果 '+restored1+'/'+restored2+'；备份：'+backup.fsName+'；'+e);}
  report('词典已保存，备份：'+backup.fsName);notify(function(){report('已保存并由后端确认加载。备份：'+backup.fsName);},function(e){report('磁盘保存成功，后端未确认加载：'+e.toString());});
 }
 edit.onClick=safe(function(){report('本地自定义：名称 '+count(read(file('names')))+' 条，参数 '+count(read(file('parameters')))+' 条。提取时排除全部有效已知译文。');});
 imp.onClick=safe(function(){var kind=chooseKind();if(!kind)return;var source=File.openDialog('导入扁平JSON词典','JSON:*.json');if(!source)return;if(source.length>10*1024*1024)throw Error('文件超过10MB');var map=validate(read(source)),box=kind==='names'?nBox:pBox;box.text=format(unknown(merge(parse(box.text).map,map),known(kind)));report('已导入待译草稿，已汉化项自动排除；点击保存后才生效。');});
 exp.onClick=safe(function(){var kind=chooseKind();if(!kind)return;var map=clean(parse(kind==='names'?nBox.text:pBox.text).map),target=File.saveDialog('导出当前草稿中已填写的词条','JSON:*.json');if(!target)return;if(target.exists&&!confirm('覆盖该文件？'))return;write(target,map);report('已导出 '+count(map)+' 条。');});
 capture.onClick=safe(function(){var comp=app.project.activeItem;if(!(comp instanceof CompItem)||!comp.selectedLayers.length)throw Error('请先在合成中选择图层');var n={},p={},failures=0,baseN=known('names'),baseP=known('parameters'),effectNames={};try{var installed=app.effects;for(var ei=0;ei<installed.length;ei++)effectNames[installed[ei].matchName]=installed[ei].displayName;}catch(ignored){}
  function collect(group){for(var j=1;j<=group.numProperties;j++){try{var prop=group.property(j),name=prop.name;if(name&&name!=='<error>')p[name]=own.call(baseP,name)?baseP[name]:'';if(prop.propertyType!==PropertyType.PROPERTY)collect(prop);}catch(ignore){failures++;}}}
  for(var i=0;i<comp.selectedLayers.length;i++){var group=comp.selectedLayers[i].property('ADBE Effect Parade');if(!group)continue;for(var k=1;k<=group.numProperties;k++){var effect=group.property(k),name=effectNames[effect.matchName]||effect.name;n[name]=own.call(baseN,name)?baseN[name]:'';collect(effect);}}
  n=unknown(n,baseN);p=unknown(p,baseP);replaceDraft(n,p);report('已筛出待译名称 '+count(n)+' 项、参数 '+count(p)+' 项；不可读取 '+failures+' 项。英文= 后填写译文。');
 });
 formatButton.onClick=safe(function(){var d=draft();nBox.text=format(d.names.map);pBox.text=format(d.parameters.map);report('已整理格式，空译文共 '+(d.names.missing+d.parameters.missing)+' 项。');});
 dedupe.onClick=safe(function(){var d=draft(),bn=read(file('names',true)),bp=read(file('parameters',true)),removed=0;function trim(map,base){for(var k in map)if(own.call(map,k)&&own.call(base,k)&&map[k]===base[k]){delete map[k];removed++;}}trim(d.names.map,bn);trim(d.parameters.map,bp);nBox.text=format(d.names.map);pBox.text=format(d.parameters.map);report('从草稿移除 '+removed+' 条基础词库同译文项；磁盘尚未改动。');});
 clearDraft.onClick=function(){if(confirm('清空两个草稿区？')){nBox.text='';pBox.text='';}};
 save.onClick=safe(function(){var d=draft(),n=clean(unknown(d.names.map,known('names'))),p=clean(unknown(d.parameters.map,known('parameters')));if(!count(n)&&!count(p))throw Error('没有新的有效译文；已汉化与空译文已跳过');if(!confirm('合并保存名称 '+count(n)+' 条、参数 '+count(p)+' 条，已汉化与空译文不重复处理。'))return;persist(merge(validate(read(file('names'))),n),merge(validate(read(file('parameters'))),p));nBox.text=format(unknown(d.names.map,known('names')));pBox.text=format(unknown(d.parameters.map,known('parameters')));});
 clearLocal.onClick=safe(function(){if(!confirm('备份后清空本地全部自定义词典？基础词库保留。'))return;persist({},{});});
 reload.onClick=safe(function(){notify(function(){report('后端已确认重载。');},function(e){report(e.toString());});});stop.onClick=safe(function(){stopBackend(function(){report('后端已关闭。');},function(e){report(e.toString());});});
 dialog.onResizing=dialog.onResize=function(){this.layout.resize();};$.global.KosuzuDictionaryWindow=dialog;dialog.show();
}
